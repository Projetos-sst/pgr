# Copie para .env.deploy (ignorado pelo Git) e preencha apenas com dados do PGR.
# Execute: npm run deploy:setup
# Para cadastrar e disparar o CD: npm run deploy:setup -- --deploy
# GitHub CLI precisa estar autenticado: gh auth login

# develop publica a branch develop; production publica a branch main.
DEPLOY_ENVIRONMENT=develop

# Mesmos nomes usados no CD do Postify/Launchpad. Nunca use os IDs do Postify.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# production para projeto separado de homologação; preview para preview de branch.
# O deploy production (main) só aceita production.
VERCEL_TARGET=production
