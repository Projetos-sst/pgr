# Worker de geração de PDF em lote (#39). Processo Node standalone que consome a
# fila `jobs`. Roda o TS direto com tsx + `--conditions=react-server` (resolve
# `server-only` para noop — mecanismo oficial do pacote). Local via docker-compose;
# a MESMA imagem é deployável em prod (Railway/Render/Fly) atrás de rede privada.
FROM node:22-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src
COPY worker ./worker

# Segredos e URLs vêm do ambiente (DATABASE_URL app_runtime, DATABASE_URL_UNPOOLED
# owner, GOTENBERG_URL, SUPABASE_*) — nunca no build.
CMD ["node", "--conditions=react-server", "--import", "tsx", "worker/index.ts"]
