{
  "name": "sst-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && ./.scripts/check-no-db-in-client.sh",
    "lint:fix": "eslint --fix && ./.scripts/check-no-db-in-client.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "fix": "npm run lint:fix && npm run format",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local .scripts/db-migrate.ts",
    "db:reset": "tsx --env-file=.env.local .scripts/db-reset-dev.ts",
    "db:backfill": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local .scripts/backfill-memberships.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@clerk/localizations": "^4.6.8",
    "@clerk/nextjs": "^7.4.1",
    "@supabase/supabase-js": "^2.106.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@swc/core": "^1.15.40",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
