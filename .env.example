# Clerk — chaves obtidas em https://dashboard.clerk.com (API Keys)
# IMPORTANTE: este arquivo é versionado. Mantenha somente placeholders aqui;
# valores reais ficam em .env.local (gitignored).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase — Project Settings → API Keys
# Use as NOVAS chaves (publishable / secret). As legadas anon / service_role
# estão deprecated e serão removidas — não use mais.
# - PUBLISHABLE_KEY: começa com "sb_publishable_..." e pode ir para o cliente.
# - Secret key ("sb_secret_...") NUNCA deve ser exposta. Se precisar, leia em
#   server-only e jamais prefixe com NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (server-only) usada pelo webhook do Clerk. NUNCA prefixar com NEXT_PUBLIC_.
# Bypassa RLS — só importar de código server-only (lib/supabase/admin.ts).
SUPABASE_SECRET_KEY=

# Clerk webhook (Dashboard → Webhooks → Endpoint → Signing Secret).
CLERK_WEBHOOK_SIGNING_SECRET=
