# Versionado: apenas placeholders. Valores reais ficam em .env.local.

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Supabase — Project Settings → API Keys (use as novas: sb_publishable_ / sb_secret_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Drizzle — Supabase Connect → ORM → Drizzle (Transaction pooler, port 6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<POSTGRES_PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres"

# Opcional: ativa a migration que cria o papel restrito `app_runtime` (RLS-aware).
APP_RUNTIME_DB_PASSWORD=

# Postgres efêmero para __tests__/integration.
INTEGRATION_DATABASE_URL=
