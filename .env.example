# ---------------------------------------------------------------------------- #
# Clerk
# ---------------------------------------------------------------------------- #
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# ---------------------------------------------------------------------------- #
# Supabase
# ---------------------------------------------------------------------------- #
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------- #
# Drizzle
# ---------------------------------------------------------------------------- #
DATABASE_URL="postgresql://app_runtime.<project-ref>:<APP_RUNTIME_DB_PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres"
DATABASE_URL_UNPOOLED="postgresql://postgres.<project-ref>:<POSTGRES_PASSWORD>@aws-1-<region>.pooler.supabase.com:5432/postgres"

APP_RUNTIME_DB_PASSWORD=

# ---------------------------------------------------------------------------- #
# Ambiente
# ---------------------------------------------------------------------------- #
# local | sandbox | homolog | production. Define o ambiente logico (independente
# de NODE_ENV, que e "production" tanto em homolog quanto em prod por causa do
# `next build`).
APP_ENV=local

# ---------------------------------------------------------------------------- #
# Basic auth de sandbox (proxy.ts) — so tem efeito com APP_ENV=sandbox
# ---------------------------------------------------------------------------- #
# Protege o ambiente inteiro com um prompt HTTP Basic nativo do navegador (evita
# indexacao/acesso publico de um ambiente que ainda nao e producao). Obrigatorios
# quando APP_ENV=sandbox (o middleware falha se estiverem vazios).
SANDBOX_BASIC_AUTH_USER=
SANDBOX_BASIC_AUTH_PASSWORD=

# ---------------------------------------------------------------------------- #
# REST API (/api/v1) — bypass de auth DEV-ONLY para testar no Postman sem token Clerk
# ---------------------------------------------------------------------------- #
# So tem efeito quando APP_ENV != production. Em producao e IGNORADO (kill-switch duro):
# /api/v1 continua exigindo sessao Clerk real. NUNCA habilite em producao.
DEV_API_AUTH_BYPASS=false
DEV_TENANT_ID=
DEV_USER_ID=dev-user
DEV_ROLE=owner

# ---------------------------------------------------------------------------- #
# Assinatura de entrega de EPI (rota publica /sign/[token])
# ---------------------------------------------------------------------------- #
# Segredo do HMAC do token de assinatura (QR/link, TTL 72h). Qualquer string longa
# aleatoria (ex.: `openssl rand -hex 32`). NUNCA commitar o valor real.
EPI_SIGN_TOKEN_SECRET=

# ---------------------------------------------------------------------------- #
# IA / Agents (sugestao de riscos e de plano 5W2H por LLM — provedor OpenRouter)
# ---------------------------------------------------------------------------- #
# Chave da API OpenRouter (SOMENTE no servidor; nunca exposta ao cliente). Sem ela,
# a sugestao por IA responde AI_UNAVAILABLE e o cadastro segue normalmente.
OPENROUTER_API_KEY=
# Modelo primario dos agentes (id do catalogo da OpenRouter). Default = gratuito,
# com saida estruturada e baixa latencia.
AI_SUGGESTION_MODEL=minimax/minimax-m3:free
# Modelos de fallback, separados por virgula e na ordem de tentativa. O Mastra troca
# de modelo sozinho quando o anterior esgota os retries (429, timeout, 5xx) — e o que
# mantem a feature de pe no tier gratuito. Vazio = usa o default do codigo.
AI_FALLBACK_MODELS=cohere/north-mini-code:free,minimax/minimax-m2.7:free
# Tentativas por modelo antes de cair para o proximo da cadeia.
AI_MAX_RETRIES_PER_MODEL=2
# Base URL do provedor. Vazio = OpenRouter real. So aponte para outro valor em
# teste/E2E (ver tests/e2e/support/openrouter-mock.mjs) — o roteador de modelos do
# Mastra honra esta variavel.
OPENROUTER_BASE_URL=
# Telemetria do Mastra (envio anonimo para o PostHog do framework). Desligada por
# padrao: a plataforma trata dado de saude ocupacional e nao exporta nada para
# terceiro alem da propria chamada ao modelo.
MASTRA_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------------- #
# Geracao de PDF (Gotenberg — emenda 1.4.0). Server-only. Vazio = geracao desabilitada.
# ---------------------------------------------------------------------------- #
# URL do servico stateless HTML->PDF. Local via docker compose: http://localhost:3001
# (ver docker-compose.yml). Em prod, apontar para o container hospedado em rede privada.
GOTENBERG_URL=
# Token Bearer opcional (proteje o endpoint em prod/gateway). Em DEV fica vazio.
GOTENBERG_TOKEN=

# ---------------------------------------------------------------------------- #
# Integration tests
# ---------------------------------------------------------------------------- #
INTEGRATION_DATABASE_URL=

# ---------------------------------------------------------------------------- #
# Billing (Stripe — emenda 1.5.0). Server-only. Vazio = billing desabilitado
# (pagina /plans mostra aviso, sem crash). Codigo 100% pronto — falta so criar a
# conta Stripe e colar as credenciais abaixo. Ver punch-list em docs/api/api-design.md.
# ---------------------------------------------------------------------------- #
# Dashboard Stripe > Developers > API keys > Secret key (modo live ou test).
STRIPE_SECRET_KEY=
# Dashboard Stripe > Developers > Webhooks > endpoint "https://<dominio>/api/webhooks/stripe"
# > Signing secret. Eventos a assinar: checkout.session.completed,
# customer.subscription.created, customer.subscription.updated, customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=
# Dashboard Stripe > Product catalog > produto "Pro" (assinatura mensal/anual) > Price ID.
STRIPE_PRICE_ID_PRO=
NEXT_PUBLIC_APP_URL=http://localhost:3000
