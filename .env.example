# ---------------------------------------------------------------------------- #
# Clerk
# ---------------------------------------------------------------------------- #
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# ---------------------------------------------------------------------------- #
# Supabase
# ---------------------------------------------------------------------------- #
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------- #
# Drizzle
# ---------------------------------------------------------------------------- #
DATABASE_URL="postgresql://app_runtime.<project-ref>:<APP_RUNTIME_DB_PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres"
DATABASE_URL_UNPOOLED="postgresql://postgres.<project-ref>:<POSTGRES_PASSWORD>@aws-1-<region>.pooler.supabase.com:5432/postgres"

APP_RUNTIME_DB_PASSWORD=

# ---------------------------------------------------------------------------- #
# Ambiente
# ---------------------------------------------------------------------------- #
# local | homolog | production. Define o ambiente logico (independente de NODE_ENV,
# que e "production" tanto em homolog quanto em prod por causa do `next build`).
APP_ENV=local

# ---------------------------------------------------------------------------- #
# REST API (/api/v1) — bypass de auth DEV-ONLY para testar no Postman sem token Clerk
# ---------------------------------------------------------------------------- #
# So tem efeito quando APP_ENV != production. Em producao e IGNORADO (kill-switch duro):
# /api/v1 continua exigindo sessao Clerk real. NUNCA habilite em producao.
DEV_API_AUTH_BYPASS=false
DEV_TENANT_ID=
DEV_USER_ID=dev-user
DEV_ROLE=owner

# ---------------------------------------------------------------------------- #
# Assinatura de entrega de EPI (rota publica /sign/[token])
# ---------------------------------------------------------------------------- #
# Segredo do HMAC do token de assinatura (QR/link, TTL 72h). Qualquer string longa
# aleatoria (ex.: `openssl rand -hex 32`). NUNCA commitar o valor real.
EPI_SIGN_TOKEN_SECRET=

# ---------------------------------------------------------------------------- #
# IA (sugestao de riscos por LLM — Anthropic/Claude)
# ---------------------------------------------------------------------------- #
# Chave da API Anthropic (SOMENTE no servidor; nunca exposta ao cliente). Sem ela,
# a sugestao por IA responde AI_UNAVAILABLE e o cadastro segue normalmente.
ANTHROPIC_API_KEY=
# Modelo usado na sugestao (default: claude-opus-4-8). Override opcional.
AI_SUGGESTION_MODEL=claude-opus-4-8

# ---------------------------------------------------------------------------- #
# Integration tests
# ---------------------------------------------------------------------------- #
INTEGRATION_DATABASE_URL=
