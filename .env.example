# Clerk — chaves obtidas em https://dashboard.clerk.com (API Keys)
# IMPORTANTE: este arquivo é versionado. Mantenha somente placeholders aqui;
# valores reais ficam em .env.local (gitignored).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase — Project Settings → API Keys
# Use as NOVAS chaves (publishable / secret). As legadas anon / service_role
# estão deprecated e serão removidas — não use mais.
# - PUBLISHABLE_KEY: começa com "sb_publishable_..." e pode ir para o cliente.
# - Secret key ("sb_secret_...") NUNCA deve ser exposta. Se precisar, leia em
#   server-only e jamais prefixe com NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (server-only) usada pelo webhook do Clerk. NUNCA prefixar com NEXT_PUBLIC_.
# Bypassa RLS — só importar de código server-only (lib/supabase/admin.ts).
SUPABASE_SECRET_KEY=

# Clerk webhook (Dashboard → Webhooks → Endpoint → Signing Secret).
CLERK_WEBHOOK_SIGNING_SECRET=

# ----------------------------------------------------------------------
# Drizzle ORM — Supabase Postgres
# ----------------------------------------------------------------------
# Pooler Supavisor em transaction mode (porta 6543), usuário = papel restrito
# `app_runtime` (sem BYPASSRLS). Lido EXCLUSIVAMENTE por lib/db/index.ts em
# runtime serverless. NÃO usar em migrations.
DATABASE_URL="postgresql://app_runtime:<APP_RUNTIME_DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexão direta (porta 5432), usuário = `postgres`. USO EXCLUSIVO de
# drizzle-kit (generate/migrate/studio) e scripts/db-reset-dev.ts. Migrations
# precisam disso porque advisory locks e algumas DDLs não funcionam sob
# pooler transaction mode.
DATABASE_URL_UNPOOLED="postgresql://postgres:<POSTGRES_PASSWORD>@db.<project-ref>.supabase.co:5432/postgres"

# Senha do papel `app_runtime` (criado pela migration 0002_app_runtime_role.sql).
# Gerada uma vez, usada para sempre. NUNCA versionar valor real.
APP_RUNTIME_DB_PASSWORD=

# URL do banco para testes de integração (branch Supabase efêmero ou Postgres
# local). Lido apenas em tests/integration/_helpers/db.ts.
INTEGRATION_DATABASE_URL=
