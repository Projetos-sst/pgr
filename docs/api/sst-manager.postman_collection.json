    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "sessionCookie",
      "value": "<cookie __session do navegador logado>"
    },
    {
      "key": "cep",
      "value": "01001000"
    },
    {
      "key": "cnpj",
      "value": "00000000000191"
    }
  ],
