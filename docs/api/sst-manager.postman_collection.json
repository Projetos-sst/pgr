    {
      "name": "Integracoes externas",
      "description": "Autofill de formularios (ViaCEP/CNPJ). Exige SESSAO Clerk real (nao ha bypass dev): cole o cookie __session em {{sessionCookie}}. Sem sessao -> 307 redirect. Dados publicos, sem tenant.",
      "item": [
        {
          "name": "GET /integrations/cep/:cep",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "__session={{sessionCookie}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/integrations/cep/{{cep}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "integrations", "cep", "{{cep}}"]
            },
            "description": "200 ok(endereco) | 404 NOT_FOUND | 422 VALIDATION (formato) | 502 UPSTREAM_ERROR | 401/307 sem sessao."
          }
        },
        {
          "name": "GET /integrations/cnpj/:cnpj",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "__session={{sessionCookie}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/integrations/cnpj/{{cnpj}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "integrations", "cnpj", "{{cnpj}}"]
            },
            "description": "200 ok(empresa+endereco) | 404 | 422 (digito verificador) | 502 | 401/307 sem sessao."
          }
        }
      ]
    }
